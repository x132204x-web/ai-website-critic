{
  "name": "ai-website-critic",
  "version": "0.2.0",
  "description": "Evidence collector and reusable AI skill for senior-level website product design critiques.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "audit": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/lib.test.ts",
    "test:integration": "vitest run tests/integration",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "chrome-launcher": "^1.0.0",
    "lighthouse": "^12.0.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@sentry/node": "10.65.0"
  }
}
